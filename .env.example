# Скопируйте в .env и поменяйте пароль базы до первого запуска.

# Порт, на котором приложение доступно снаружи
APP_PORT=8081

# База данных (наружу не публикуется, доступна только приложению)
POSTGRES_USER=onyx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onyx

# Сколько дней живёт вход без посещений (при каждом посещении срок продлевается; максимум 400)
SESSION_DAYS=365

# false — закрыть регистрацию новых пользователей (первый пользователь может зарегистрироваться всегда)
ALLOW_REGISTRATION=true

# Предельный размер одного загружаемого файла, МБ
MAX_UPLOAD_MB=50
